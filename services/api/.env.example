# Copy to .env (git-ignored) and fill in.
DATABASE_URL=postgresql+psycopg://localhost/text_to_audiobook

# Free key from https://aistudio.google.com: powers the AI director
GEMINI_API_KEY=your-key-here

# Optional: free key from https://console.groq.com. Takes over when Gemini is overloaded
# or its free daily quota is used up (Gemini Flash allows only 20 requests a day).
# GROQ_API_KEY=your-key-here
# Who labels lines first: gemini (more expressive, the default) or groq (much faster)
# LABEL_PROVIDER=gemini

# Optional: an AI second opinion on the few short lines the import rules can't decide
# (e.g. sentence-case chapter titles and "Show more" junk in a copied X thread). Off by default;
# only those lines (a few hundred tokens per book) are sent. "gemini" uses GEMINI_API_KEY above.
# STRUCTURE_AI=off            # off | gemini | claude
# ANTHROPIC_API_KEY=your-key-here   # for claude (https://console.anthropic.com)
